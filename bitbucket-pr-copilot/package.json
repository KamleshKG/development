{
  "name": "bitbucket-pr-copilot",
  "displayName": "Bitbucket PR Copilot PoC",
  "description": "PoC plugin to post AI suggestions as comments on Bitbucket PRs",
  "version": "0.0.1",
  "publisher": "kk",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onCommand:bitbucketPRCopilot.postSuggestions"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bitbucketPRCopilot.postSuggestions",
        "title": "Post AI Suggestions to Bitbucket PR"
      }
    ]
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "simple-git": "^3.19.1"
  }
}
